<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WX-2.3: AccuWeather only (AccuNet; HTTPS; network security config trusts that host only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WorkManager adds this for foreground work, which the app never does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Weather">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DayActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DiscussionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- WX-4.1: the live tile's data, read-only, for the WP launcher (callers and their key checked in code). -->
        <provider
            android:name=".TileProvider"
            android:authorities="io.github.wotworth.weather.tile"
            android:exported="true" />
    </application>
</manifest>
