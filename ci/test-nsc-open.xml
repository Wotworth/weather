<?xml version="1.0" encoding="utf-8"?>
<!-- CI proof: the network check must reject this config (it trusts every host). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
